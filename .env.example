PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Gemini API - powers enhanced next-phrase suggestions (review writing textarea),
# full review generation, and the review-brain corpus builder (scripts/build-brain.js).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional: override Gemini base URL (e.g. for proxies)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
